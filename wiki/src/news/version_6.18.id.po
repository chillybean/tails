msgid "<h1 id=\"features\">New features</h1>\n"
msgstr ""

#. type: Title ##
#, no-wrap
msgid "*WebTunnel* bridges"
msgstr ""

#. type: Plain text
msgid ""
"You can now use *WebTunnel* bridges to connect to the Tor network from Tails."
msgstr ""

#. type: Plain text
msgid ""
"[*WebTunnel*](https://blog.torproject.org/introducing-webtunnel-evading-"
"censorship-by-hiding-in-plain-sight/)  is a bridge technology that is "
"particularly good at circumventing censorship and might work from places "
"where *obfs4* bridges are blocked. *WebTunnel* disguises your connection as "
"ordinary web traffic."
msgstr ""

#. type: Plain text
msgid ""
"To get *WebTunnel* bridges, visit [https://bridges.torproject.org/](https://"
"bridges.torproject.org/bridges?transport=webtunnel)."
msgstr ""

#. type: Plain text
#, no-wrap
msgid "[[!img webtunnel.png class=\"screenshot\" alt=\"\"]]\n"
msgstr ""

#. type: Plain text
#, no-wrap
msgid "<h1 id=\"changes\">Changes and updates</h1>\n"
msgstr ""

#. type: Bullet: '- '
msgid ""
"Update *Tor Browser* to [14.5.5](https://blog.torproject.org/new-release-tor-"
"browser-1455)."
msgstr ""

#. type: Bullet: '- '
msgid ""
"Update *Thunderbird* to [128.12.0](https://www.thunderbird.net/en-US/"
"thunderbird/128.12.0esr/releasenotes/)."
msgstr ""

#. type: Plain text
msgid ""
"For more details, read our [[!tails_gitweb debian/changelog "
"desc=\"changelog\"]]."
msgstr ""

