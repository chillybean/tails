#~ msgstr ""
#~ "Este método não funciona [[com DVD|support/known_issues#index11h2]], veja "
#~ "o [[!tails_ticket 5447]]."

#~ msgid "- By pressing the power button of the computer."
#~ msgstr "- Pressionando o botão de ligar do computador."

