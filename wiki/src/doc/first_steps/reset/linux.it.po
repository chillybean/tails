#~ "     **Utilities**&nbsp;▸\n"
#~ "     **Disks**\n"
#~ "   </span>\n"
#~ "   to start *GNOME Disks*.\n"
#~ msgstr ""
#~ "1. Scegli\n"
#~ "   <span class=\"menuchoice\">\n"
#~ "     **Applicazioni**&nbsp;▸\n"
#~ "     **Utilità**&nbsp;▸\n"
#~ "     **Dischi**\n"
#~ "   </span>\n"
#~ "   per avviare <span class=\"applicazion\">GNOME Disks</span>.\n"

#~ msgid ""
