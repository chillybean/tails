#!/bin/sh

set -eu
set -o pipefail

REF="$(git rev-parse "$1")"

UNWANTED_COMMITS=$(git log --grep='^(fixup|squash)!' --pretty=oneline "$REF"..)

if [ -n "$UNWANTED_COMMITS" ]; then
    echo "Please squash these commits before merging:"
    echo
    echo "${UNWANTED_COMMITS}" | sed --regexp-extended 's,^, - ,'
    echo
    echo "Pro tip: git config --global rebase.autosquash true"
    exit 1
fi
