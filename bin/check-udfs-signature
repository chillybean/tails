#!/bin/bash

set -eu

UDFS_DIR=wiki/src/upgrade/v2/

getUpgradesYml() {
    find "$UDFS_DIR" -type f -name upgrades.yml | LC_ALL=C sort
}

error=false
while read -r upgradesYml; do
    if ! [ -f "${upgradesYml}.pgp" ]; then
        error=true
        echo "${upgradesYml}.pgp missing" >&2
    fi
done < <(getUpgradesYml)

if $error; then
    exit 1
fi

while read -r upgradesYml; do
    if ! sqop verify "${upgradesYml}.pgp" wiki/src/tails-signing.key \
        <"${upgradesYml}" &>/dev/null; then
        error=true
        echo "${upgradesYml}.pgp invalid signature" >&2
        continue
    fi
    if ! sqop verify "${upgradesYml}.pgp" wiki/src/tails-signing-minimal.key \
        <"${upgradesYml}" &>/dev/null; then
        error=true
        echo "${upgradesYml}.pgp is valid with tails-signing.key, but not with tails-signing-minimal.key" >&2
    fi
done < <(getUpgradesYml)

if $error; then
    exit 1
fi
exit 0
