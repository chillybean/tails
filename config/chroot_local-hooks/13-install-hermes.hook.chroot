#!/bin/sh
set -e

# ============================================================
# Tails Hermes Hook — Installs Hermes AI Agent + llama.cpp
# ============================================================

echo "============================================"
echo "  Installing Hermes AI Agent for Tails"
echo "============================================"

# --- 1. Create hermes system user ---
echo "[1/7] Creating hermes user..."
addgroup --system --gid 125 hermes 2>/dev/null || true
adduser --system --uid 118 --gid 125 --no-create-home \
    --gecos "Hermes AI Agent" hermes 2>/dev/null || true

# --- 2. Install llama.cpp server ---
echo "[2/7] Installing llama.cpp..."
LLAMA_DIR="/opt/llama-cpp"
mkdir -p "$LLAMA_DIR"

# Copy bundled llama.cpp binaries and libs
if [ -d "/opt/llama-cpp" ] && [ -f "/opt/llama-cpp/llama-server" ]; then
    echo "  Using bundled llama.cpp binary."
    chmod +x /opt/llama-cpp/llama-server
    chmod +x /opt/llama-cpp/llama-cli 2>/dev/null || true
    # Symlink into PATH
    ln -sf /opt/llama-cpp/llama-server /usr/local/bin/llama-server
    ln -sf /opt/llama-cpp/llama-cli /usr/local/bin/llama-cli
    echo "  llama.cpp installed: $(/opt/llama-cpp/llama-server --version 2>&1 | head -1)"
else
    echo "  WARNING: llama.cpp binary not found in local-includes."
    echo "  Run: curl -fsSL https://github.com/ggml-org/llama.cpp/releases/latest/download/llama-linux-x64.tar.gz"
fi

# Create llama.cpp library path config
echo "/opt/llama-cpp" > /etc/ld.so.conf.d/llama-cpp.conf 2>/dev/null || true
ldconfig 2>/dev/null || true

# --- 3. Set up model directory ---
echo "[3/7] Setting up model directory..."
mkdir -p /var/lib/llama/models
chown -R hermes:hermes /var/lib/llama

# Create Hermes workspace for file operations
mkdir -p /home/amnesia/HermesWorkspace
chown -R 1000:1000 /home/amnesia/HermesWorkspace

# Copy bundled model if present
if [ -f "/var/lib/llama/models/gemma-4-E4B-it-Q4_K_M.gguf" ]; then
    echo "  Bundled Gemma 4 E4B model found."
    ls -lh /var/lib/llama/models/gemma-4-E4B-it-Q4_K_M.gguf
else
    echo "  No bundled model found. Download on first boot with:"
    echo "    hermes-download-model"
fi

# --- 4. Install Hermes Agent ---
echo "[4/7] Installing Hermes Agent..."
HERMES_VENV="/opt/hermes"
python3 -m venv "$HERMES_VENV" 2>/dev/null || {
    echo "  WARNING: python3 -m venv failed. pip/pip3 not functional."
    echo "  Skipping Python package installation (needed at runtime)."
    # Create a minimal placeholder so later steps don't fail
    mkdir -p "$HERMES_VENV/bin"
    ln -sf /usr/bin/python3 "$HERMES_VENV/bin/python3" 2>/dev/null || true
}

# Upgrade pip/wheel (may fail in offline build env — that's OK)
if [ -x "$HERMES_VENV/bin/pip" ]; then
    "$HERMES_VENV/bin/pip" install --upgrade pip setuptools wheel 2>/dev/null || \
        true  # Offline build: use bundled pip version
fi

# Note: hermes-agent PyPI package is NOT installed during build.
# It will be installed at runtime by the hermes-download-model script
# or manually with: pip install hermes-agent
echo "  Hermes venv created. PyPI packages installed at runtime."

# Symlink hermes into PATH
ln -sf "$HERMES_VENV/bin/hermes" /usr/local/bin/hermes 2>/dev/null || true

# --- 5. Install Hermes GTK4 Desktop App ---
echo "[5/7] Installing Hermes Desktop App..."
# GUI files are auto-copied by live-build from config/includes.chroot/opt/hermes/gui/
# to /opt/hermes/gui/ in the chroot. Just verify they exist.
HERMES_GUI_DIR="/opt/hermes/gui"
if [ -f "$HERMES_GUI_DIR/hermes_app.py" ]; then
    echo "  GUI files found: $HERMES_GUI_DIR/"
    ls -lh "$HERMES_GUI_DIR/"
else
    echo "  WARNING: GUI files not found at $HERMES_GUI_DIR/"
fi

# --- 6. Configure Hermes backend ---
echo "[6/7] Configuring Hermes backend..."
# Config is auto-copied by live-build from config/includes.chroot/etc/hermes/
# Verify it exists and adjust for live environment
HERMES_CONFIG_DIR="/etc/hermes"
if [ -f "$HERMES_CONFIG_DIR/config.yaml" ]; then
    echo "  Config found: $HERMES_CONFIG_DIR/config.yaml"
else
    echo "  WARNING: Config not found. Creating minimal config."
    mkdir -p "$HERMES_CONFIG_DIR"
    cat > "$HERMES_CONFIG_DIR/config.yaml" << 'HERMES_CFG'
model:
  provider: llama.cpp
  name: "gemma-4-E4B-it-Q4_K_M.gguf"
  base_url: "http://127.0.0.1:8080"
llama_cpp:
  host: "127.0.0.1"
  port: 8080
  model_path: "/var/lib/llama/models/gemma-4-E4B-it-Q4_K_M.gguf"
  n_ctx: 8192
  n_predict: 2048
  temperature: 0.7
  enable_thinking: false
agent:
  name: "HermesLive"
  persona: "helpful, concise, privacy-focused AI assistant"
  max_context_tokens: 8192
  enable_memory: true
  memory_dir: "/var/lib/hermes/memory"
privacy:
  allow_external_apis: false
  tor_proxy: "socks5://127.0.0.1:9050"
  telemetry: false
gui:
  theme: "dark"
  accent_color: "#00D4AA"
  font: "Inter"
  font_size: 14
HERMES_CFG
fi

# --- 7. Enable llama.cpp systemd service ---
echo "[7/7] Enabling llama.cpp service..."
if command -v systemctl >/dev/null 2>&1; then
    systemctl enable llama-cpp.service 2>/dev/null || true
    echo "  llama.cpp service enabled (starts after Tor)."
else
    echo "  WARNING: systemctl not available (expected in build env)."
fi

# --- Set up persistence symlinks ---
echo "Setting up persistence..."
mkdir -p /var/lib/hermes/memory
chown -R hermes:hermes /var/lib/hermes

# --- Configure Tor proxy for hermes user only ---
echo "Configuring Tor proxy for hermes user..."
cat > /etc/profile.d/hermes-tor-proxy.sh << 'PROFILE'
# Hermes AI — route outbound traffic through Tor
# Only applies to interactive login shells; systemd services use their own env
export HTTP_PROXY="socks5h://127.0.0.1:9050"
export HTTPS_PROXY="socks5h://127.0.0.1:9050"
export http_proxy="socks5h://127.0.0.1:9050"
export https_proxy="socks5h://127.0.0.1:9050"
PROFILE
chmod 644 /etc/profile.d/hermes-tor-proxy.sh

echo ""
echo "============================================"
echo "  Hermes AI Agent installed successfully!"
echo "============================================"
echo ""
echo "  Binary:     /usr/local/bin/hermes"
echo "  GUI:        /opt/hermes/gui/"
echo "  Config:     /etc/hermes/config.yaml"
echo "  llama.cpp:  /opt/llama-cpp/llama-server"
echo "  Service:    systemctl start llama-cpp (after Tor)"
echo "  Models:     /var/lib/llama/models/"
echo "  Tor proxy:  socks5h://127.0.0.1:9050"
echo ""

# --- Update desktop and icon databases ---
echo "Updating desktop database..."
if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database /usr/share/applications/
fi
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache /usr/share/icons/hicolor/ 2>/dev/null || true
fi

echo "Done!"
