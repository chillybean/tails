#!/bin/sh
set -e

# ============================================================
# Tails Hermes Hook — Installs Hermes AI Agent + Ollama
# ============================================================

echo "============================================"
echo "  Installing Hermes AI Agent for Tails"
echo "============================================"

# --- 1. Create hermes system user ---
echo "[1/6] Creating hermes user..."
addgroup --system --gid 125 hermes
adduser --system --uid 118 --gid 125 --no-create-home \
    --gecos "Hermes AI Agent" hermes 2>/dev/null || true

# --- 2. Install Ollama ---
echo "[2/6] Installing Ollama..."
OLLAMA_INSTALL_DIR="/opt/ollama"
mkdir -p "$OLLAMA_INSTALL_DIR"

# Check if Ollama binary was bundled in local-includes
if [ -f "/opt/ollama/ollama" ]; then
    echo "  Using bundled Ollama binary."
elif [ ! -f "$OLLAMA_INSTALL_DIR/ollama" ]; then
    curl -fsSL https://ollama.com/download/ollama-linux-amd64 \
        -o "$OLLAMA_INSTALL_DIR/ollama" 2>/dev/null || \
    echo "  WARNING: Could not download Ollama binary (build env has no internet)"
fi

chmod +x "$OLLAMA_INSTALL_DIR/ollama" 2>/dev/null || true

# Symlink into PATH
ln -sf "$OLLAMA_INSTALL_DIR/ollama" /usr/local/bin/ollama 2>/dev/null || true

# Ollama data directory (will be on persistent volume at runtime)
mkdir -p /var/lib/ollama
chown hermes:hermes /var/lib/ollama

# Create ollama system user
addgroup --system --gid 126 ollama 2>/dev/null || true
adduser --system --uid 119 --gid 126 --no-create-home \
    --gecos "Ollama Service" ollama 2>/dev/null || true
usermod -aG hermes ollama 2>/dev/null || true

# --- 3. Install Hermes Agent ---
echo "[3/6] Installing Hermes Agent..."
HERMES_VENV="/opt/hermes"
python3 -m venv "$HERMES_VENV"
"$HERMES_VENV/bin/pip" install --upgrade pip setuptools wheel 2>/dev/null

# Install hermes-agent from PyPI
"$HERMES_VENV/bin/pip" install hermes-agent 2>/dev/null || \
    echo "  WARNING: Could not install hermes-agent from PyPI (no network in build)"

# Symlink hermes into PATH
ln -sf "$HERMES_VENV/bin/hermes" /usr/local/bin/hermes 2>/dev/null || true

# --- 4. Install Hermes GTK4 Desktop App ---
echo "[4/6] Installing Hermes Desktop App..."
HERMES_GUI_DIR="/opt/hermes/gui"
mkdir -p "$HERMES_GUI_DIR"

# Copy GUI files from chroot_local-includes
if [ -d "/tmp/hermes-gui" ]; then
    cp -r /tmp/hermes-gui/* "$HERMES_GUI_DIR/"
fi

# --- 5. Configure Ollama as Hermes backend ---
echo "[5/6] Configuring Hermes backend..."
HERMES_CONFIG_DIR="/etc/hermes"
mkdir -p "$HERMES_CONFIG_DIR"

cat > "$HERMES_CONFIG_DIR/config.yaml" << 'HERMES_CFG'
# Hermes Agent Configuration for Tails
# Local-only AI via Ollama — no cloud, no API keys needed

model:
  provider: ollama
  name: "qwen2.5:7b"
  base_url: "http://127.0.0.1:11434"

ollama:
  host: "127.0.0.1"
  port: 11434
  data_dir: "/var/lib/ollama"
  auto_pull: true
  default_model: "qwen2.5:7b"
  # Ollama downloads models through Tor
  tor_proxy: "socks5h://127.0.0.1:9050"

agent:
  name: "TailsHermes"
  persona: "helpful, concise, privacy-focused AI assistant"
  max_context_tokens: 8192
  enable_memory: true
  memory_dir: "/var/lib/hermes/memory"

privacy:
  # All traffic stays local — no external API calls
  allow_external_apis: false
  # Route any external requests through Tor
  tor_proxy: "socks5://127.0.0.1:9050"
  # Disable telemetry
  telemetry: false

gui:
  theme: "dark"
  accent_color: "#00D4AA"
  font: "Inter"
  font_size: 14
HERMES_CFG

# --- 6. Enable Ollama systemd service ---
echo "[6/6] Enabling Ollama service..."
if command -v systemctl >/dev/null 2>&1; then
    systemctl enable ollama.service 2>/dev/null || true
    echo "  Ollama service enabled (starts after Tor)."
else
    echo "  WARNING: systemctl not available (expected in build env)."
fi

# --- 7. Set up persistence symlinks ---
echo "[7/7] Setting up persistence..."
# At runtime, these will be symlinked to the persistent volume
mkdir -p /var/lib/hermes/memory
chown -R hermes:hermes /var/lib/hermes

# --- 8. Configure Tor proxy for Ollama model downloads ---
echo "[8/8] Configuring Tor proxy for Ollama..."
# Write a profile script so hermes/ollama users get Tor proxy env vars
cat > /etc/profile.d/hermes-tor-proxy.sh << 'PROFILE'
# Hermes AI — route outbound traffic through Tor
export HTTP_PROXY="socks5h://127.0.0.1:9050"
export HTTPS_PROXY="socks5h://127.0.0.1:9050"
export http_proxy="socks5h://127.0.0.1:9050"
export https_proxy="socks5h://127.0.0.1:9050"
# Ollama-specific
export OLLAMA_ORIGINS="*"
PROFILE
chmod 644 /etc/profile.d/hermes-tor-proxy.sh

echo ""
echo "============================================"
echo "  Hermes AI Agent installed successfully!"
echo "============================================"
echo ""
echo "  Binary:     /usr/local/bin/hermes"
echo "  GUI:        /opt/hermes/gui/"
echo "  Config:     /etc/hermes/config.yaml"
echo "  Ollama:     /usr/local/bin/ollama"
echo "  Service:    systemctl start ollama (after Tor)"
echo "  Models:     /var/lib/ollama/"
echo "  Tor proxy:  socks5h://127.0.0.1:9050"
echo ""

# --- 9. Update desktop and icon databases ---
echo "[9/9] Updating desktop database..."
if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database /usr/share/applications/
fi
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache /usr/share/icons/hicolor/ 2>/dev/null || true
fi

echo "Done!"
