#: config/chroot_local-includes/usr/src/iuk/lib/Tails/IUK/Frontend.pm:295
msgid ""
"<b>An error occurred while updating the signing key.</b>\\n\\n<b>This "
"prevents determining whether an upgrade is available from our website.</"
"b>\\n\\nCheck your network connection and restart Tails.\\n\\nIf the problem "
"persists, try doing a manual upgrade."
msgstr ""
"<b>Došlo k chybe pri aktualizácii podpisového kľúča.</b>\\n\\n<b>Toto "
"zabraňuje určeniu, či je na našej webovej stránke dostupná aktualizácia.</"
"b>\\n\\nSkontrolujte svoje sieťové pripojenie a reštartujte Tails.\\n\\nAk "
"problém pretrváva, skúste vykonať manuálnu aktualizáciu."

#: config/chroot_local-includes/usr/src/iuk/lib/Tails/IUK/Frontend.pm:309
msgid "Error while downloading the signing key"
msgstr "Chyba pri sťahovaní podpisového kľúča"

#: config/chroot_local-includes/usr/src/iuk/lib/Tails/IUK/Frontend.pm:342
msgid "Error while checking for upgrades"
msgstr "Chyba pri kontrole aktualizácií"

#: config/chroot_local-includes/usr/src/iuk/lib/Tails/IUK/Frontend.pm:344
msgid ""
"<b>Could not determine whether an upgrade is available from our website.</"
"b>\n"
"\n"
"Check your network connection and restart Tails.\n"
"\n"
"If the problem persists, try doing a manual upgrade."
msgstr ""
"<b>Nebolo možné určiť, či je na našej webovej stránke dostupná aktualizácia."
"</b>\n"
"\n"
"Skontrolujte svoje sieťové pripojenie a reštartujte Tails.\n"
"\n"
"Ak problém pretrváva, skúste vykonať manuálnu aktualizáciu."

#: config/chroot_local-includes/usr/src/iuk/lib/Tails/IUK/Frontend.pm:359
msgid "no automatic upgrade is available from our website for this version"
msgstr ""
"pre túto verziu nie je na našej webovej stránke dostupná žiadna automatická "
"aktualizácia"

#: config/chroot_local-includes/usr/src/iuk/lib/Tails/IUK/Frontend.pm:365
msgid "your device was not created using a USB image or Tails Cloner"
msgstr ""
"vaše zariadenie nebolo vytvorené pomocou obrazu USB alebo nástroja Tails "
"Cloner"

#: config/chroot_local-includes/usr/src/iuk/lib/Tails/IUK/Frontend.pm:370
msgid "Tails was started from a DVD or a read-only device"
msgstr "Tails bol spustený z DVD alebo zariadenia iba na čítanie"

#: config/chroot_local-includes/usr/src/iuk/lib/Tails/IUK/Frontend.pm:375
msgid "there is not enough free space on the Tails system partition"
msgstr "na systémovej partícii Tails nie je dostatok voľného miesta"

#: config/chroot_local-includes/usr/src/iuk/lib/Tails/IUK/Frontend.pm:380
msgid "not enough memory is available on this system"
msgstr "v tomto systéme nie je dostatok dostupnej pamäte"

#: config/chroot_local-includes/usr/src/iuk/lib/Tails/IUK/Frontend.pm:385
#, perl-brace-format
msgid "No explanation available for reason '{reason}'."
msgstr "Pre dôvod '{reason}' nie je k dispozícii žiadne vysvetlenie."

#: config/chroot_local-includes/usr/src/iuk/lib/Tails/IUK/Frontend.pm:408
msgid "The system is up-to-date"
msgstr "Systém je aktuálny"

#: config/chroot_local-includes/usr/src/iuk/lib/Tails/IUK/Frontend.pm:411
msgid ""
"You are currently running the latest version. There is no upgrade "
"available.\n"
msgstr ""
"Práve používate najnovšiu verziu. Nie je k dispozícii žiadna aktualizácia.\n"

#: config/chroot_local-includes/usr/src/iuk/lib/Tails/IUK/Frontend.pm:414
msgid "Tails is up to date"
msgstr "Tails je aktuálny"

#: config/chroot_local-includes/usr/src/iuk/lib/Tails/IUK/Frontend.pm:420
msgid "This version of Tails is outdated, and may have security issues."
msgstr "Táto verzia Tails je zastaraná a môže mať bezpečnostné problémy."

#: config/chroot_local-includes/usr/src/iuk/lib/Tails/IUK/Frontend.pm:450
#, perl-brace-format
msgid ""
"The available incremental upgrade requires {space_needed} of free space on "
"Tails system partition,  but only {free_space} is available."
msgstr ""
"Dostupná inkrementálna aktualizácia vyžaduje {space_needed} voľného miesta "
"na systémovej partícii Tails,  ale k dispozícii je iba {free_space}."

#: config/chroot_local-includes/usr/src/iuk/lib/Tails/IUK/Frontend.pm:462
#, perl-brace-format
msgid ""
"The available incremental upgrade requires {memory_needed} of free memory, "
"but only {free_memory} is available."
msgstr ""
"Dostupná inkrementálna aktualizácia vyžaduje {memory_needed} voľnej pamäte, "
"ale k dispozícii je iba {free_memory}."

#: config/chroot_local-includes/usr/src/iuk/lib/Tails/IUK/Frontend.pm:473
msgid ""
"An error occurred while detecting available upgrades.\n"
"This should not happen. Please report a bug."
msgstr ""
"Počas zisťovania dostupných aktualizácií došlo k chybe.\n"
"Toto by sa nemalo stať. Prosím, nahláste chybu."

#: config/chroot_local-includes/usr/src/iuk/lib/Tails/IUK/Frontend.pm:476
#: config/chroot_local-includes/usr/src/iuk/lib/Tails/IUK/Frontend.pm:495
msgid "Error while detecting available upgrades"
msgstr "Chyba pri zisťovaní dostupných aktualizácií"

#: config/chroot_local-includes/usr/src/iuk/lib/Tails/IUK/Frontend.pm:491
msgid ""
"An incremental upgrade is available, but no full upgrade is.\n"
"This should not happen. Please report a bug."
msgstr ""
"Je dostupná prírastková aktualizácia, nie však plná aktualizácia.\n"
"Takáto situácia by nemala nastať. Nahláste, prosím, chybu."

#: config/chroot_local-includes/usr/src/iuk/lib/Tails/IUK/Frontend.pm:504
#, perl-brace-format
msgid ""
"<b>You should upgrade to {name} {version}.</b>\n"
"\n"
"For more information about this new version, go to {details_url}\n"
"\n"
"We recommend you close all other applications during the upgrade.\n"
"Downloading the upgrade might take a long time, from several minutes to a "
"few hours.\n"
"\n"
"Download size: {size}\n"
"\n"
"Do you want to upgrade now?"
msgstr ""
"<b>Mali by ste aktualizovať na {name} {version}.</b>\n"
"\n"
"Ďalšie informácie o tejto novej verzii nájdete na {details_url}\n"
"\n"
"Počas aktualizácie odporúčame zatvoriť všetky ostatné aplikácie.\n"
"Sťahovanie aktualizácie môže trvať dlho, od niekoľkých minút až po niekoľko "
"hodín.\n"
"\n"
