msgstr "Nepodarilo sa opraviť súborový systém vášho trvalého úložiska."

#: config/chroot_local-includes/usr/lib/python3/dist-packages/tailsgreeter/ui/main_window.py:544
msgid "Start Tails to send an error report and learn how to recover your data."
msgstr ""
"Spustite Tails, aby ste poslali hlásenie o chybe a dozvedeli sa, ako obnoviť "
"vaše údaje."

